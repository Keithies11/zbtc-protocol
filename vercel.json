{
  "version": 2,
  "builds": [
    {
      "src": "public/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "public/legacy-v1-miner.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/legacy-v1-miner.html",
      "dest": "public/legacy-v1-miner.html"
    },
    {
      "src": "/(.*)",
      "dest": "public/index.html"
    }
  ]
}
