{
  "version": 2,
  "builds": [
    {
      "src": "public/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "public/zyn-twitter-header.png",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "temporary-prompt-emerald-zsr9wxt.vercel.app"
        }
      ],
      "dest": "https://miner.zynintel.com/$1",
      "status": 308
    },
    {
      "src": "/zyn-twitter-header.png",
      "dest": "/public/zyn-twitter-header.png"
    },
    {
      "src": "/(.*)",
      "dest": "public/index.html"
    }
  ]
}
